# ==============================================================================
# AirthAI MSME Business OS - Backend API Environment Configuration Template
# COPY this file to .env and configure values for your local environment.
# NEVER commit .env to version control.
# ==============================================================================

# Application
NODE_ENV=development
PORT=3000
API_PREFIX=/api/v1
LOG_LEVEL=debug
CORS_ORIGINS=http://localhost:3000,http://localhost:5000,http://localhost:8080

# Database (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/airthai_db?schema=public"
DIRECT_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/airthai_db?schema=public"

# Authentication & Security
JWT_SECRET=replace_with_a_secure_random_64_char_secret_for_production
JWT_REFRESH_SECRET=replace_with_a_different_secure_random_64_char_secret_for_production
JWT_EXPIRES_IN=3600s
REFRESH_TOKEN_EXPIRES_IN=7d

# Cache & Queues (Redis - Future Phase)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# File Storage (S3 / Local - Future Phase)
STORAGE_PROVIDER=local
S3_BUCKET=airthai-storage
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# AI Copilot Engine (Future Phase)
OPENAI_API_KEY=
AI_MODEL=gpt-4o

