datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ==========================================
// ENUMS
// ==========================================

enum TaxType {
  UNREGISTERED
  REGULAR
  COMPOSITION
}

enum BillFormat {
  A4_STANDARD
  A5_COMPACT
  THERMAL_80MM
  THERMAL_58MM
}

enum ItemType {
  GOODS
  SERVICE
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  PARTIALLY_PAID
  PAID
  CANCELLED
}

enum PurchaseStatus {
  ORDERED
  RECEIVED
  CANCELLED
}

enum PaymentType {
  CUSTOMER_RECEIPT
  SUPPLIER_PAYMENT
}

enum PaymentMethod {
  CASH
  UPI
  BANK_TRANSFER
  CHEQUE
  CARD
}

enum PaymentStatus {
  UNPAID
  PARTIALLY_PAID
  PAID
}

enum StockMovementType {
  PURCHASE
  SALE
  SALE_RETURN
  PURCHASE_RETURN
  ADJUSTMENT_ADD
  ADJUSTMENT_SUB
  DAMAGE
  TRANSFER
}

enum AccountType {
  ASSET
  LIABILITY
  EQUITY
  REVENUE
  EXPENSE
}

enum SyncStatus {
  SYNCED
  PENDING
  CONFLICT
}

// ==========================================
// LAYER 1: IDENTITY & MULTI-TENANCY
// ==========================================

model User {
  id              String         @id @default(uuid())
  email           String         @unique
  phone           String?        @unique
  passwordHash    String
  fullName        String
  avatarUrl       String?
  isActive        Boolean        @default(true)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  businessUsers   BusinessUser[]
  auditLogs       AuditLog[]
  aiConversations AiConversation[]
  aiQueryLogs     AiQueryLog[]

  @@map("users")
}

model Business {
  id                 String               @id @default(uuid())
  name               String
  legalName          String?
  gstin              String?
  pan                String?
  phone              String?
  email              String?
  addressLine1       String?
  addressLine2       String?
  city               String?
  state              String?
  stateCode          String?
  pincode            String?
  currency           String               @default("INR")
  taxType            TaxType              @default(REGULAR)
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt

  settings           BusinessSettings?
  documentSequences  DocumentSequence[]
  branches           Branch[]
  warehouses         Warehouse[]
  businessUsers      BusinessUser[]
  roles              Role[]
  customers          Customer[]
  suppliers          Supplier[]
  categories         Category[]
  units              Unit[]
  products           Product[]
  productVariants    ProductVariant[]
  stocks             Stock[]
  stockMovements     StockMovement[]
  quotations         Quotation[]
  salesOrders        SalesOrder[]
  invoices           Invoice[]
  invoiceItems       InvoiceItem[]
  purchases          Purchase[]
  purchaseItems      PurchaseItem[]
  payments           Payment[]
  paymentAllocations PaymentAllocation[]
  expenseCategories  ExpenseCategory[]
  expenses           Expense[]
  accounts           Account[]
  journalEntries     JournalEntry[]
  ledgerEntries      LedgerEntry[]
  gstRecords         GstRecord[]
  auditLogs          AuditLog[]
  syncQueues         SyncQueue[]
  subscriptions      Subscription[]
  aiConversations    AiConversation[]
  aiQueryLogs        AiQueryLog[]

  @@index([gstin])
  @@map("businesses")
}

model BusinessSettings {
  id                 String     @id @default(uuid())
  businessId         String     @unique
  business           Business   @relation(fields: [businessId], references: [id], onDelete: Cascade)
  trackInventory     Boolean    @default(true)
  allowNegativeStock Boolean    @default(false)
  defaultBillFormat  BillFormat @default(A4_STANDARD)
  enableGst          Boolean    @default(true)
  defaultGstRate     Decimal    @default(18.00) @db.Decimal(5, 2)
  financialYearStart DateTime
  updatedAt          DateTime   @updatedAt

  @@map("business_settings")
}

model DocumentSequence {
  id           String   @id @default(uuid())
  businessId   String
  business     Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  documentType String
  prefix       String
  nextNumber   Int      @default(1)
  fiscalYear   String
  updatedAt    DateTime @updatedAt

  @@unique([businessId, documentType, fiscalYear])
  @@map("document_sequences")
}

model Branch {
  id            String         @id @default(uuid())
  businessId    String
  business      Business       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name          String
  code          String?
  address       String?
  stateCode     String?
  isMain        Boolean        @default(false)
  isActive      Boolean        @default(true)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  warehouses    Warehouse[]
  invoices      Invoice[]
  purchases     Purchase[]
  expenses      Expense[]
  businessUsers BusinessUser[]

  @@unique([businessId, id])
  @@unique([businessId, name])
  @@map("branches")
}

model Role {
  id            String         @id @default(uuid())
  businessId    String?
  business      Business?      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name          String
  description   String?
  isSystem      Boolean        @default(false)
  permissions   Json
  createdAt     DateTime       @default(now())

  businessUsers BusinessUser[]

  @@unique([businessId, id])
  @@map("roles")
}

model BusinessUser {
  id              String    @id @default(uuid())
  businessId      String
  business        Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  userId          String
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  roleId          String
  role            Role      @relation(fields: [roleId], references: [id], onDelete: Restrict)
  defaultBranchId String?
  defaultBranch   Branch?   @relation(fields: [businessId, defaultBranchId], references: [businessId, id], onDelete: Restrict)
  isActive        Boolean   @default(true)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@unique([businessId, userId])
  @@index([businessId])
  @@index([userId])
  @@map("business_users")
}

// ==========================================
// LAYER 2: MASTER DATA
// ==========================================

model Customer {
  id               String       @id @default(uuid())
  businessId       String
  business         Business     @relation(fields: [businessId], references: [id], onDelete: Restrict)
  name             String
  phone            String?
  email            String?
  gstin            String?
  billingAddress   String?
  shippingAddress  String?
  city             String?
  state            String?
  stateCode        String?
  pincode          String?
  openingBalance   Decimal      @default(0.00) @db.Decimal(12, 2)
  currentBalance   Decimal      @default(0.00) @db.Decimal(12, 2)
  creditLimit      Decimal?     @db.Decimal(12, 2)
  creditPeriodDays Int          @default(0)
  status           String       @default("ACTIVE")
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  invoices         Invoice[]
  quotations       Quotation[]
  salesOrders      SalesOrder[]
  payments         Payment[]

  @@unique([businessId, id])
  @@index([businessId, name])
  @@index([businessId, phone])
  @@map("customers")
}

model Supplier {
  id             String     @id @default(uuid())
  businessId     String
  business       Business   @relation(fields: [businessId], references: [id], onDelete: Restrict)
  name           String
  phone          String?
  email          String?
  gstin          String?
  pan            String?
  address        String?
  city           String?
  state          String?
  stateCode      String?
  bankName       String?
  accountNumber  String?
  ifscCode       String?
  openingBalance Decimal    @default(0.00) @db.Decimal(12, 2)
  currentBalance Decimal    @default(0.00) @db.Decimal(12, 2)
  status         String     @default("ACTIVE")
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  purchases      Purchase[]
  payments       Payment[]

  @@unique([businessId, id])
  @@index([businessId, name])
  @@map("suppliers")
}

model Category {
  id         String     @id @default(uuid())
  businessId String
  business   Business   @relation(fields: [businessId], references: [id], onDelete: Restrict)
  name       String
  parentId   String?
  parent     Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children   Category[] @relation("CategoryHierarchy")
  createdAt  DateTime   @default(now())

  products   Product[]

  @@unique([businessId, id])
  @@unique([businessId, name])
  @@map("categories")
}

model Unit {
  id         String    @id @default(uuid())
  businessId String
  business   Business  @relation(fields: [businessId], references: [id], onDelete: Restrict)
  name       String
  symbol     String
  createdAt  DateTime  @default(now())

  products   Product[]

  @@unique([businessId, id])
  @@unique([businessId, symbol])
  @@map("units")
}

model Product {
  id              String            @id @default(uuid())
  businessId      String
  business        Business          @relation(fields: [businessId], references: [id], onDelete: Restrict)
  categoryId      String?
  category        Category?         @relation(fields: [businessId, categoryId], references: [businessId, id], onDelete: Restrict)
  unitId          String?
  unit            Unit?             @relation(fields: [businessId, unitId], references: [businessId, id], onDelete: Restrict)
  name            String
  sku             String?
  barcode         String?
  description     String?
  hsnCode         String?
  itemType        ItemType          @default(GOODS)
  trackStock      Boolean           @default(true)
  gstRate         Decimal           @default(0.00) @db.Decimal(5, 2)
  cessRate        Decimal           @default(0.00) @db.Decimal(5, 2)
  purchasePrice   Decimal           @default(0.00) @db.Decimal(12, 2)
  salePrice       Decimal           @default(0.00) @db.Decimal(12, 2)
  mrp             Decimal?          @db.Decimal(12, 2)
  minStockLevel   Decimal           @default(0.00) @db.Decimal(12, 2)
  currentStock    Decimal           @default(0.00) @db.Decimal(12, 2)
  status          String            @default("ACTIVE")
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  variants        ProductVariant[]
  stocks          Stock[]
  stockMovements  StockMovement[]
  invoiceItems    InvoiceItem[]
  purchaseItems   PurchaseItem[]
  quotationItems  QuotationItem[]
  salesOrderItems SalesOrderItem[]

  @@unique([businessId, id])
  @@index([businessId, name])
  @@index([businessId, sku])
  @@index([businessId, barcode])
  @@map("products")
}

model ProductVariant {
  id            String    @id @default(uuid())
  businessId    String
  business      Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  productId     String
  product       Product   @relation(fields: [businessId, productId], references: [businessId, id], onDelete: Cascade)
  name          String
  sku           String?
  barcode       String?
  salePrice     Decimal   @db.Decimal(12, 2)
  purchasePrice Decimal   @db.Decimal(12, 2)
  createdAt     DateTime  @default(now())

  stocks        Stock[]

  @@unique([businessId, productId, id])
  @@unique([productId, name])
  @@map("product_variants")
}

// ==========================================
// LAYER 3: INVENTORY & WAREHOUSE
// ==========================================

model Warehouse {
  id             String          @id @default(uuid())
  businessId     String
  business       Business        @relation(fields: [businessId], references: [id], onDelete: Restrict)
  branchId       String?
  branch         Branch?         @relation(fields: [businessId, branchId], references: [businessId, id], onDelete: Restrict)
  name           String
  address        String?
  isDefault      Boolean         @default(false)
  createdAt      DateTime        @default(now())

  stocks         Stock[]
  stockMovements StockMovement[]

  @@unique([businessId, id])
  @@map("warehouses")
}

model Stock {
  id             String          @id @default(uuid())
  businessId     String
  business       Business        @relation(fields: [businessId], references: [id], onDelete: Cascade)
  warehouseId    String
  warehouse      Warehouse       @relation(fields: [businessId, warehouseId], references: [businessId, id], onDelete: Restrict)
  productId      String
  product        Product         @relation(fields: [businessId, productId], references: [businessId, id], onDelete: Restrict)
  variantId      String?
  variant        ProductVariant? @relation(fields: [businessId, productId, variantId], references: [businessId, productId, id], onDelete: Restrict)
  quantityOnHand Decimal         @default(0.00) @db.Decimal(12, 2)
  updatedAt      DateTime        @updatedAt

  @@unique([businessId, id])
  @@index([businessId, productId])
  @@index([warehouseId, productId])
  @@map("stocks")
}

model StockMovement {
  id            String            @id @default(uuid())
  businessId    String
  business      Business          @relation(fields: [businessId], references: [id], onDelete: Restrict)
  warehouseId   String
  warehouse     Warehouse         @relation(fields: [businessId, warehouseId], references: [businessId, id], onDelete: Restrict)
  productId     String
  product       Product           @relation(fields: [businessId, productId], references: [businessId, id], onDelete: Restrict)
  variantId     String?
  movementType  StockMovementType
  quantity      Decimal           @db.Decimal(12, 2)
  unitCost      Decimal           @db.Decimal(12, 2)
  referenceType String?
  referenceId   String?
  notes         String?
  createdAt     DateTime          @default(now())

  @@unique([businessId, id])
  @@index([businessId, productId, createdAt])
  @@index([referenceType, referenceId])
  @@map("stock_movements")
}

// ==========================================
// LAYER 4: COMMERCIAL TRANSACTIONS
// ==========================================

model Quotation {
  id              String          @id @default(uuid())
  businessId      String
  business        Business        @relation(fields: [businessId], references: [id], onDelete: Restrict)
  customerId      String?
  customer        Customer?       @relation(fields: [businessId, customerId], references: [businessId, id], onDelete: Restrict)
  quotationNumber String
  date            DateTime
  validUntil      DateTime?
  status          String          @default("DRAFT")
  subtotal        Decimal         @db.Decimal(12, 2)
  discountAmount  Decimal         @default(0.00) @db.Decimal(12, 2)
  taxAmount       Decimal         @db.Decimal(12, 2)
  totalAmount     Decimal         @db.Decimal(12, 2)
  notes           String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  items           QuotationItem[]

  @@unique([businessId, id])
  @@unique([businessId, quotationNumber])
  @@map("quotations")
}

model QuotationItem {
  id             String    @id @default(uuid())
  quotationId    String
  quotation      Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  productId      String?
  product        Product?  @relation(fields: [productId], references: [id], onDelete: Restrict)
  description    String
  hsnCode        String?
  quantity       Decimal   @db.Decimal(12, 2)
  unitPrice      Decimal   @db.Decimal(12, 2)
  discountAmount Decimal   @default(0.00) @db.Decimal(12, 2)
  taxAmount      Decimal   @db.Decimal(12, 2)
  totalAmount    Decimal   @db.Decimal(12, 2)

  @@map("quotation_items")
}

model SalesOrder {
  id             String           @id @default(uuid())
  businessId     String
  business       Business         @relation(fields: [businessId], references: [id], onDelete: Restrict)
  customerId     String?
  customer       Customer?        @relation(fields: [businessId, customerId], references: [businessId, id], onDelete: Restrict)
  orderNumber    String
  date           DateTime
  status         String           @default("PENDING")
  subtotal       Decimal          @db.Decimal(12, 2)
  taxAmount      Decimal          @db.Decimal(12, 2)
  totalAmount    Decimal          @db.Decimal(12, 2)
  notes          String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  items          SalesOrderItem[]

  @@unique([businessId, id])
  @@unique([businessId, orderNumber])
  @@map("sales_orders")
}

model SalesOrderItem {
  id             String     @id @default(uuid())
  orderId        String
  order          SalesOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId      String?
  product        Product?   @relation(fields: [productId], references: [id], onDelete: Restrict)
  description    String
  hsnCode        String?
  quantity       Decimal    @db.Decimal(12, 2)
  unitPrice      Decimal    @db.Decimal(12, 2)
  taxAmount      Decimal    @db.Decimal(12, 2)
  totalAmount    Decimal    @db.Decimal(12, 2)

  @@map("sales_order_items")
}

model Invoice {
  id                  String              @id @default(uuid())
  businessId          String
  business            Business            @relation(fields: [businessId], references: [id], onDelete: Restrict)
  branchId            String
  branch              Branch              @relation(fields: [businessId, branchId], references: [businessId, id], onDelete: Restrict)
  customerId          String?
  customer            Customer?           @relation(fields: [businessId, customerId], references: [businessId, id], onDelete: Restrict)
  invoiceNumber       String
  invoiceDate         DateTime
  dueDate             DateTime?
  status              InvoiceStatus       @default(ISSUED)
  billFormat          BillFormat          @default(A4_STANDARD)
  placeOfSupply       String
  isInterState        Boolean
  isReverseCharge     Boolean             @default(false)
  subtotal            Decimal             @db.Decimal(12, 2)
  discountType        String?
  discountAmount      Decimal             @default(0.00) @db.Decimal(12, 2)
  taxableAmount       Decimal             @db.Decimal(12, 2)
  cgstAmount          Decimal             @default(0.00) @db.Decimal(12, 2)
  sgstAmount          Decimal             @default(0.00) @db.Decimal(12, 2)
  igstAmount          Decimal             @default(0.00) @db.Decimal(12, 2)
  cessAmount          Decimal             @default(0.00) @db.Decimal(12, 2)
  roundOff            Decimal             @default(0.00) @db.Decimal(5, 2)
  totalAmount         Decimal             @db.Decimal(12, 2)
  receivedAmount      Decimal             @default(0.00) @db.Decimal(12, 2)
  balanceAmount       Decimal             @db.Decimal(12, 2)
  notes               String?
  terms               String?
  cancelledAt         DateTime?
  cancellationReason  String?
  clientOperationId   String?
  syncStatus          SyncStatus          @default(SYNCED)
  version             Int                 @default(1)
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  items               InvoiceItem[]
  paymentAllocations  PaymentAllocation[]
  gstRecords          GstRecord[]

  @@unique([businessId, id])
  @@unique([businessId, invoiceNumber])
  @@index([businessId, customerId])
  @@index([businessId, invoiceDate])
  @@map("invoices")
}

model InvoiceItem {
  id             String    @id @default(uuid())
  businessId     String
  business       Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  invoiceId      String
  invoice        Invoice   @relation(fields: [businessId, invoiceId], references: [businessId, id], onDelete: Cascade)
  productId      String?
  product        Product?  @relation(fields: [businessId, productId], references: [businessId, id], onDelete: Restrict)
  variantId      String?
  description    String
  hsnCode        String?
  quantity       Decimal   @db.Decimal(12, 2)
  unitPrice      Decimal   @db.Decimal(12, 2)
  discountAmount Decimal   @default(0.00) @db.Decimal(12, 2)
  taxableAmount  Decimal   @db.Decimal(12, 2)
  gstRate        Decimal   @db.Decimal(5, 2)
  cgstAmount     Decimal   @default(0.00) @db.Decimal(12, 2)
  sgstAmount     Decimal   @default(0.00) @db.Decimal(12, 2)
  igstAmount     Decimal   @default(0.00) @db.Decimal(12, 2)
  cessAmount     Decimal   @default(0.00) @db.Decimal(12, 2)
  totalAmount    Decimal   @db.Decimal(12, 2)

  @@unique([businessId, id])
  @@index([invoiceId])
  @@index([productId])
  @@map("invoice_items")
}

model Purchase {
  id                 String              @id @default(uuid())
  businessId         String
  business           Business            @relation(fields: [businessId], references: [id], onDelete: Restrict)
  branchId           String
  branch             Branch              @relation(fields: [businessId, branchId], references: [businessId, id], onDelete: Restrict)
  supplierId         String
  supplier           Supplier            @relation(fields: [businessId, supplierId], references: [businessId, id], onDelete: Restrict)
  billNumber         String
  billDate           DateTime
  status             PurchaseStatus      @default(RECEIVED)
  subtotal           Decimal             @db.Decimal(12, 2)
  taxAmount          Decimal             @db.Decimal(12, 2)
  totalAmount        Decimal             @db.Decimal(12, 2)
  paidAmount         Decimal             @default(0.00) @db.Decimal(12, 2)
  balanceAmount      Decimal             @db.Decimal(12, 2)
  paymentStatus      PaymentStatus       @default(UNPAID)
  notes              String?
  clientOperationId  String?
  syncStatus         SyncStatus          @default(SYNCED)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  items              PurchaseItem[]
  paymentAllocations PaymentAllocation[]
  gstRecords         GstRecord[]

  @@unique([businessId, id])
  @@unique([businessId, supplierId, billNumber])
  @@map("purchases")
}

model PurchaseItem {
  id          String   @id @default(uuid())
  businessId  String
  business    Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  purchaseId  String
  purchase    Purchase @relation(fields: [businessId, purchaseId], references: [businessId, id], onDelete: Cascade)
  productId   String
  product     Product  @relation(fields: [businessId, productId], references: [businessId, id], onDelete: Restrict)
  description String
  hsnCode     String?
  quantity    Decimal  @db.Decimal(12, 2)
  unitCost    Decimal  @db.Decimal(12, 2)
  taxRate     Decimal  @db.Decimal(5, 2)
  taxAmount   Decimal  @db.Decimal(12, 2)
  totalAmount Decimal  @db.Decimal(12, 2)

  @@unique([businessId, id])
  @@index([purchaseId])
  @@map("purchase_items")
}

// ==========================================
// LAYER 5: SETTLEMENTS & ACCOUNTING
// ==========================================

model Payment {
  id                String              @id @default(uuid())
  businessId        String
  business          Business            @relation(fields: [businessId], references: [id], onDelete: Restrict)
  paymentNumber     String
  paymentType       PaymentType
  customerId        String?
  customer          Customer?           @relation(fields: [businessId, customerId], references: [businessId, id], onDelete: Restrict)
  supplierId        String?
  supplier          Supplier?           @relation(fields: [businessId, supplierId], references: [businessId, id], onDelete: Restrict)
  paymentDate       DateTime
  amount            Decimal             @db.Decimal(12, 2)
  paymentMethod     PaymentMethod
  referenceNumber   String?
  notes             String?
  clientOperationId String?
  syncStatus        SyncStatus          @default(SYNCED)
  createdAt         DateTime            @default(now())

  allocations       PaymentAllocation[]

  @@unique([businessId, id])
  @@unique([businessId, paymentNumber])
  @@map("payments")
}

model PaymentAllocation {
  id         String    @id @default(uuid())
  businessId String
  business   Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  paymentId  String
  payment    Payment   @relation(fields: [businessId, paymentId], references: [businessId, id], onDelete: Cascade)
  invoiceId  String?
  invoice    Invoice?  @relation(fields: [businessId, invoiceId], references: [businessId, id], onDelete: Restrict)
  purchaseId String?
  purchase   Purchase? @relation(fields: [businessId, purchaseId], references: [businessId, id], onDelete: Restrict)
  amount     Decimal   @db.Decimal(12, 2)
  createdAt  DateTime  @default(now())

  @@unique([businessId, id])
  @@index([paymentId])
  @@index([invoiceId])
  @@index([purchaseId])
  @@map("payment_allocations")
}

model ExpenseCategory {
  id         String    @id @default(uuid())
  businessId String
  business   Business  @relation(fields: [businessId], references: [id], onDelete: Restrict)
  name       String
  createdAt  DateTime  @default(now())

  expenses   Expense[]

  @@unique([businessId, id])
  @@unique([businessId, name])
  @@map("expense_categories")
}

model Expense {
  id              String          @id @default(uuid())
  businessId      String
  business        Business        @relation(fields: [businessId], references: [id], onDelete: Restrict)
  branchId        String?
  branch          Branch?         @relation(fields: [businessId, branchId], references: [businessId, id], onDelete: Restrict)
  categoryId      String
  category        ExpenseCategory @relation(fields: [businessId, categoryId], references: [businessId, id], onDelete: Restrict)
  expenseNumber   String
  date            DateTime
  amount          Decimal         @db.Decimal(12, 2)
  paymentMethod   PaymentMethod
  vendor          String?
  gstin           String?
  gstAmount       Decimal         @default(0.00) @db.Decimal(12, 2)
  isTaxDeductible Boolean         @default(true)
  receiptUrl      String?
  notes           String?
  createdAt       DateTime        @default(now())

  @@unique([businessId, id])
  @@unique([businessId, expenseNumber])
  @@map("expenses")
}

model Account {
  id            String        @id @default(uuid())
  businessId    String
  business      Business      @relation(fields: [businessId], references: [id], onDelete: Restrict)
  code          String
  name          String
  type          AccountType
  balance       Decimal       @default(0.00) @db.Decimal(14, 2)
  createdAt     DateTime      @default(now())

  ledgerEntries LedgerEntry[]

  @@unique([businessId, id])
  @@unique([businessId, code])
  @@map("accounts")
}

model JournalEntry {
  id            String        @id @default(uuid())
  businessId    String
  business      Business      @relation(fields: [businessId], references: [id], onDelete: Restrict)
  entryNumber   String
  date          DateTime
  narration     String
  referenceType String?
  referenceId   String?
  createdAt     DateTime      @default(now())

  ledgerEntries LedgerEntry[]

  @@unique([businessId, id])
  @@unique([businessId, entryNumber])
  @@map("journal_entries")
}

model LedgerEntry {
  id             String       @id @default(uuid())
  businessId     String
  business       Business     @relation(fields: [businessId], references: [id], onDelete: Cascade)
  journalEntryId String
  journalEntry   JournalEntry @relation(fields: [businessId, journalEntryId], references: [businessId, id], onDelete: Cascade)
  accountId      String
  account        Account      @relation(fields: [businessId, accountId], references: [businessId, id], onDelete: Restrict)
  debit          Decimal      @default(0.00) @db.Decimal(12, 2)
  credit         Decimal      @default(0.00) @db.Decimal(12, 2)

  @@unique([businessId, id])
  @@index([journalEntryId])
  @@index([accountId])
  @@map("ledger_entries")
}

model GstRecord {
  id              String    @id @default(uuid())
  businessId      String
  business        Business  @relation(fields: [businessId], references: [id], onDelete: Restrict)
  returnPeriod    String
  transactionType String
  invoiceId       String?
  invoice         Invoice?  @relation(fields: [businessId, invoiceId], references: [businessId, id], onDelete: Restrict)
  purchaseId      String?
  purchase        Purchase? @relation(fields: [businessId, purchaseId], references: [businessId, id], onDelete: Restrict)
  gstin           String?
  placeOfSupply   String
  taxableValue    Decimal   @db.Decimal(12, 2)
  cgstAmount      Decimal   @default(0.00) @db.Decimal(12, 2)
  sgstAmount      Decimal   @default(0.00) @db.Decimal(12, 2)
  igstAmount      Decimal   @default(0.00) @db.Decimal(12, 2)
  cessAmount      Decimal   @default(0.00) @db.Decimal(12, 2)
  hsnSummary      Json?
  isCancelled     Boolean   @default(false)
  createdAt       DateTime  @default(now())

  @@unique([businessId, id])
  @@index([businessId, returnPeriod])
  @@map("gst_records")
}

// ==========================================
// LAYER 6: AUDIT & SYNC INFRASTRUCTURE
// ==========================================

model AuditLog {
  id         String   @id @default(uuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Restrict)
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: Restrict)
  action     String
  entityName String
  entityId   String
  oldValues  Json?
  newValues  Json?
  ipAddress  String?
  userAgent  String?
  timestamp  DateTime @default(now())

  @@unique([businessId, id])
  @@index([businessId, entityName, entityId])
  @@index([businessId, timestamp])
  @@map("audit_logs")
}

model SyncQueue {
  id                 String    @id @default(uuid())
  businessId         String
  business           Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  clientOperationId  String
  entityType         String
  entityId           String
  operation          String
  payload            Json
  status             String    @default("PENDING")
  processedAt        DateTime?
  errorMessage       String?
  createdAt          DateTime  @default(now())

  @@unique([businessId, clientOperationId])
  @@map("sync_queues")
}

// ==========================================
// LAYER 7: PLANS & FUTURE SCOPE
// ==========================================

model Plan {
  id                 String         @id @default(uuid())
  name               String
  maxUsers           Int            @default(1)
  maxInvoicesMonthly Int            @default(100)
  priceMonthly       Decimal        @db.Decimal(10, 2)
  createdAt          DateTime       @default(now())

  subscriptions      Subscription[]

  @@map("plans")
}

model Subscription {
  id         String    @id @default(uuid())
  businessId String
  business   Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  planId     String
  plan       Plan      @relation(fields: [planId], references: [id], onDelete: Restrict)
  status     String    @default("ACTIVE")
  validUntil DateTime
  createdAt  DateTime  @default(now())

  @@map("subscriptions")
}

model AiConversation {
  id         String       @id @default(uuid())
  businessId String
  business   Business     @relation(fields: [businessId], references: [id], onDelete: Cascade)
  userId     String
  user       User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  title      String
  createdAt  DateTime     @default(now())

  logs       AiQueryLog[]

  @@map("ai_conversations")
}

model AiQueryLog {
  id             String         @id @default(uuid())
  businessId     String
  business       Business       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  userId         String
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  conversationId String
  conversation   AiConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  prompt         String
  response       String
  tokenCount     Int            @default(0)
  latencyMs      Int            @default(0)
  createdAt      DateTime       @default(now())

  @@map("ai_query_logs")
}
